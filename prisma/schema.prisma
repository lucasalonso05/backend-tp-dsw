generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum state_event{
  PENDING
  CONFIRMED
  FULFILLED
  CANCELLED
  
}

enum state_digital_ticket{
  UNSCANNED
  SCANNED
  
}

model assists {
  id_assistant Int
  id_event Int

  date_time_assist DateTime?

  FK_assistant assistant @relation(fields: [id_assistant], references: [id])
  FK_event event @relation(fields: [id_event], references: [id])
  @@id([id_assistant, id_event])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("assists")
}

model event {
  id Int @id @default (autoincrement())

  title String
  category String
  date_time_start DateTime 
  date_time_end DateTime
  state event_state @default(PENDIENTE)
  stock Int
  entries entry[]
  assists assist[]
    
  id_organiser Int
  id_place Int
  date_time_creation DateTime @default(now())
  date_time_cancellation DateTime?
  
  FK_place place @relation(fields: [id_place], references: [id]) 
  FK_organiser organiser @relation(fields: [id_organiser], references: [id]) 
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("events")
}

model place{
  id Int @id @default (autoincrement())
  capacity Int
  description String?
  city String
  street String
  street_number String
  zip_code Int
  province String

  events event[]
  
  @@map("places")
}

model entry{
  id_event Int
  code Int  @default(autoincrement())
  entry_type String
  unit_price Decimal @db.Decimal(10, 2)
  date_time_start DateTime
  date_time_end DateTime
  @@id([id_event, code])
  FK_event event @relation(fields: [id_event], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("entries")
}

model order{
  id_buyer Int
  code Int  @default(autoincrement())
  
  date_time DateTime @default(now())
  unit_price Decimal @db.Decimal(10, 2)
  quantity Int
  total_price Decimal @db.Decimal(10, 2)
  tickets ticket_digital[]
  
  FK_buyer buyer @relation(fields: [id_buyer], references: [id])
  @@id([id_buyer, code])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

model digital_ticket{
  id_buyer Int
  code_order Int
  code Int @default(autoincrement())
  
  qr String @unique
  state state_digital_ticket @default(NO_ESCANEADO)
  date_time_use DateTime?
  
  FK_order order @relation(fields: [id_buyer, code_order], references: [id_buyer, code])
  @@id([id_buyer, code_order, code])

  id_assistant  Int      @unique  // @unique porque es 1:1
  FK_assistant  assistant @relation(fields: [id_assistant], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("digital_tickets")
}

model assistant{
  id Int @id @default(autoincrement())
  
  doc_type String
  doc_number String
  name String
  surname String
  email String @unique
  telephone String @unique

  ticket digital_ticket?
  
  assists assist[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("assists")
}

model organiser{
  id Int @id @default(autoincrement())

  doc_type String
  doc_number String
  name String
  surname String
  email String @unique
  telephone String @unique
  cuit String?

  events event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organisers")
}

model buyer{
  id Int @id @default(autoincrement())

  doc_type String
  doc_number String
  name String
  surname String
  email String @unique
  telephone String @unique
 
  orders order[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("buyers")
}
