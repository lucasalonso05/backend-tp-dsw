generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum event_status {
  CONFIRMED
  FINISHED
  CANCELLED
}

enum role_user {
  ASSISTANT
  ORGANISER
  ADMIN
}

enum status_digital_ticket {
  UNSCANNED
  SCANNED
}

enum order_status {
  PENDING   // creada, esperando confirmación de pago
  PAID
  CANCELLED
  EXPIRED   // venció la ventana de pago y se liberó el stock
}

model user {
  id Int @id @default(autoincrement())

  role       role_user @default(ASSISTANT)
  doc_type   String
  doc_number String
  name       String
  surname    String
  email      String  @unique
  password   String
  telephone  String  @unique
  cuit       String?

  events  event[]
  assists assist[]
  places  place[]
  tickets digital_ticket[]
  orders  order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([doc_type, doc_number])
  @@map("users")
}

model place {
  id Int @id @default(autoincrement())

  name          String
  capacity      Int
  description   String?
  province      String
  city          String
  street        String
  street_number String
  zip_code      String

  id_user Int
  FK_user user @relation(fields: [id_user], references: [id])

  events event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("places")
}

model event {
  id Int @id @default(autoincrement())

  title           String
  category        String
  date_time_start DateTime
  date_time_end   DateTime
  status          event_status @default(CONFIRMED)
  total_stock     Int

  // Tope declarado del evento. Con partición estricta el cupo real vive
  // en cada entry; se valida sum(entry.stock) <= total_stock <= place.capacity
  

  date_time_cancellation DateTime?

  entries entry[]
  assists assist[]

  id_user  Int
  id_place Int
  FK_user  user  @relation(fields: [id_user], references: [id])
  FK_place place @relation(fields: [id_place], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("events")
}

model entry {
  id Int @id @default(autoincrement())

  entry_name        String
  entry_description String?
  unit_price        Decimal  @db.Decimal(10, 2)
  date_time_start   DateTime
  date_time_end     DateTime
  stock             Int
  sold_stock        Int @default(0)
  // Cupo cerrado de este tipo de entrada. stock es fijo, sold_stock es el
  // contador de vendidas o reservadas. Al editar: nuevo stock >= sold_stock.


  id_event Int
  FK_event event @relation(fields: [id_event], references: [id])

  items order_item[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id_event, entry_name])
  @@map("entries")
}

model order {
  id Int @id @default(autoincrement())

  status            order_status @default(PENDING)
  total             Decimal      @db.Decimal(10, 2)
  date_time_payment DateTime?
  payment_reference String? // id de la transacción en la pasarela de pago

  id_user Int
  FK_user user @relation(fields: [id_user], references: [id])

  items order_item[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

model order_item {
  id Int @id @default(autoincrement())

  quantity   Int
  unit_price Decimal @db.Decimal(10, 2) // precio congelado al momento de la compra
  subtotal   Decimal @db.Decimal(10, 2)

  id_order Int
  id_entry Int
  FK_order order @relation(fields: [id_order], references: [id])
  FK_entry entry @relation(fields: [id_entry], references: [id])

  tickets digital_ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id_order, id_entry])
  @@map("order_items")
}

model digital_ticket {
  id Int @id @default(autoincrement())

  qr_code        String                @unique // UUID o token firmado, nunca el id
  status         status_digital_ticket @default(UNSCANNED)
  date_time_scan DateTime?

  id_order_item Int
  id_user       Int // titular del ticket
  FK_order_item order_item @relation(fields: [id_order_item], references: [id])
  FK_user       user       @relation(fields: [id_user], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([id_order_item])
  @@map("digital_tickets")
}

model assist {
  id_user  Int
  id_event Int

  date_time_assist DateTime?

  FK_user  user  @relation(fields: [id_user], references: [id])
  FK_event event @relation(fields: [id_event], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([id_user, id_event])
  @@map("assists")
}