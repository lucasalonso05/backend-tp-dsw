# Variables de entorno del back de Eventify.
# Copiá este archivo como `.env` (desarrollo) y completá los valores.
# El `.env` real NUNCA se sube a git: tiene secretos. En producción, estas mismas
# variables se cargan en Vercel (proyecto eventify-api → Settings → Environment Variables).

# Ambiente. En tu compu, development. Los tests usan test (y leen `.env.test`).
# En Vercel no hace falta cargarla: Vercel la pone en production.
NODE_ENV=development

# Puerto del servidor local.
PORT=3000

# --- Secretos ---

# Base de datos (Neon). En tu compu: la branch development, con la conexión directa
# (el host sin "-pooler"). Se copia desde Neon → Connect. Obligatoria.
DATABASE_URL=postgresql://usuario:contraseña@host/neondb?sslmode=require

# Secreto para firmar los tokens de sesión. Obligatorio. Generá uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Claves de EmailJS (Account → General). Sin ellas la app anda igual, pero no manda mails.
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# --- Opcionales ---

# Orígenes que pueden llamar a la API, separados por coma. Sin esta variable se acepta
# solo http://localhost:5173. El primero se usa también para los links de los mails.
# FRONTEND_URL=http://localhost:5173

# Servicio y plantilla de EmailJS. Si no están, se usan estos valores.
# EMAILJS_SERVICE_ID=eventify_gmail
# EMAILJS_TEMPLATE_ID=orden_pagada