# Copiar a .env y completar. El .env NO se versiona.

PORT=3000
NODE_ENV=development

# Postgres (Neon). Sugerido: agregar ?connect_timeout=10&pool_timeout=10
DATABASE_URL=

# Secreto de firma de los JWT. Cadena larga y aleatoria.
# Si falta, el servidor NO arranca (src/config/config.ts).
JWT_SECRET=

# Origen autorizado por CORS. Si falta, usa http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Admin semilla que crea `npx prisma db seed`
ADMIN_EMAIL=admin@eventify.com
ADMIN_PASSWORD=

# Minutos que una orden PENDING retiene stock antes de expirar (default 15)
ORDER_PAYMENT_WINDOW_MINUTES=15
